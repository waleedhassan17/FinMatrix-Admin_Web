# Backend base URL, including the /api/v1 prefix.
# Unset = production (see API_BASE_URL in src/networks/network/apiHelpers.ts).
#   production: https://finmatrix-api.duckdns.org/api/v1
#   local:      http://localhost:3000/api/v1
#
# Point this at a local backend before testing approve/reject: those buttons
# settle real payments for real customers against production.
# VITE_API_URL=http://localhost:3000/api/v1

# Sentry DSN for frontend error reporting. Unset = Sentry is never loaded
# (see src/app/observability.ts). Set it in the Vercel project settings.
# VITE_SENTRY_DSN=

# Optional release name reported with each error, e.g. the git SHA.
# VITE_RELEASE=
